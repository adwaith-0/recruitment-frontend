# Recruitment AI – local configuration (NON-SECRET values only)
# Copy to .env:  cp .env.example .env
#
# Read by the API bridge (server/), by vite.config.js to find the bridge, and by the
# provisioning scripts in agent/. Nothing here uses the VITE_ prefix, so nothing is bundled
# into browser code. No keys or tokens are needed: authentication is Microsoft Entra ID
# (your `az login` session locally; a managed identity in Azure with AZURE_AUTH_MODE=default).

# --- Microsoft Foundry -------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://recruitment-ai-lab-resource.services.ai.azure.com/api/projects/recruitment-ai-lab
FOUNDRY_AGENT_NAME=recruitment-source-agent
# "prompt" = source-grounded Prompt Agent (default). "hosted" = previous hosted agent, rollback only
# (set FOUNDRY_AGENT_NAME=recruitment-maf-test with it).
FOUNDRY_AGENT_KIND=prompt
# Optional: pin an agent version (otherwise the latest version is used)
# FOUNDRY_AGENT_VERSION=2
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.6-luna
FOUNDRY_MCP_CONNECTION_NAME=recruitment-source-kb-mi
# api-version for the hosted (rollback) endpoint only
FOUNDRY_API_VERSION=v1

# --- Azure resources (used by agent/*.py) -------------------------------------------
AZURE_SUBSCRIPTION_ID=10c4eebb-b707-4290-b8b7-44510debbb67
AZURE_RESOURCE_GROUP=rg-adwaithakumar210-3095
AZURE_SEARCH_ENDPOINT=https://recruitment-ai-lab-srch-svvg.search.windows.net
AZURE_SEARCH_KNOWLEDGE_BASE=knowledgebase606
AZURE_SEARCH_API_VERSION=2026-08-01-preview
AZURE_STORAGE_ACCOUNT=ragstorage4u

# --- Credential --------------------------------------------------------------------
# "cli" = Azure CLI login only (default); "default" = DefaultAzureCredential chain (managed identity etc.)
AZURE_AUTH_MODE=cli
# Optional: pin the Entra tenant used to get tokens
# AZURE_TENANT_ID=

# --- Bridge --------------------------------------------------------------------------
# Local bridge address (Vite proxies /api to it)
API_HOST=127.0.0.1
API_PORT=8787
# Upstream request timeout in ms
AGENT_TIMEOUT_MS=120000
MAX_MESSAGE_CHARS=8000
# Idle lifetime of a browser session's server-side conversation state
SESSION_TTL_MINUTES=120
